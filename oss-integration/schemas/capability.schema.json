{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-integration.local/schemas/capability.schema.json",
  "title": "Capability",
  "description": "One capability extracted from one source. Note that licenseStatus and securityStatus are carried on the capability itself, so selection never has to go back to the repository to find out whether a capability is usable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilityId", "name", "description", "category", "sourceRepository", "sourceVersion", "sourceCommit", "evidence", "strength", "limitations", "dependencies", "compatibility", "licenseStatus", "securityStatus", "confidence"],
  "properties": {
    "capabilityId": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Capability id from the taxonomy. Never a repository name." },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": { "enum": ["design", "implementation", "automation", "verification", "quality", "security", "orchestration", "unknown"] },
    "sourceRepository": { "type": "string" },
    "sourceVersion": { "type": "string" },
    "sourceCommit": { "type": "string" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "strength": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "conflictsWith", "notes"],
      "properties": {
        "runtime": { "type": "array", "items": { "type": "string" } },
        "conflictsWith": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "licenseStatus": { "enum": ["REUSE_OK", "REUSE_WITH_CONDITIONS", "REFERENCE_ONLY", "LEGAL_REVIEW", "BLOCK"] },
    "securityStatus": { "enum": ["PASS", "CONDITIONAL", "REVIEW_REQUIRED", "BLOCK", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "Derived from the evidence class and the gate results. Never asserted independently." }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "basis", "notes"],
      "properties": {
        "class": { "enum": ["VERIFIED", "SUPPORTED", "INFERRED", "CLAIMED", "UNKNOWN"] },
        "basis": {
          "type": "array",
          "items": { "enum": ["executable-test", "source-inspection", "reproducible-example", "official-documentation", "independent-evidence", "maintainer-activity", "readme-claim", "social-popularity"] },
          "description": "What was actually inspected. The class is derived from this, strongest basis wins, and social-popularity alone can never exceed UNKNOWN."
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
