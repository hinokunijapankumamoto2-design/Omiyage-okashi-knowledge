# ==========================================================
# Omiyage Meeting Intelligence — 環境変数サンプル
# ==========================================================
# 使い方:
#   1. このファイルをコピーして「.env」という名前のファイルを作る
#        cp .env.example .env
#   2. .env を VS Code などのエディタで開く（ターミナルに貼らない）
#   3. 下の各項目の = の右側に値を書く
#   4. .env は .gitignore 済み。git には絶対に上がらない。
#
# 注意:
#   - APPKEY をチャットやメールに貼らない
#   - <...> のプレースホルダのまま実行するとスクリプトが停止する（保険）
# ==========================================================


# ----------------------------------------------------------
# [1] AMIVOICE_APPKEY  ← 必須
# ----------------------------------------------------------
# AmiVoice の認証キー。
# 取得場所: AmiVoice MyPage（https://acp.amivoice.com/）にログイン
#           → 「APPKEY」または「ワンタイムAPPKEY」の欄に表示される文字列
# 形式の目安: 空白を含まない英数字の長い文字列（16文字以上）
# 例（ダミー）: AMIVOICE_APPKEY=abcd1234efgh5678ijkl9012
AMIVOICE_APPKEY=


# ----------------------------------------------------------
# [2] AMIVOICE_ENGINE  ← 必須
# ----------------------------------------------------------
# 使用する音声認識エンジンの「接続エンジン名」。
# 取得場所: AmiVoice MyPage → エンジン一覧の「Connection Engine Name」列
# 選び方  : 会議・商談の文字起こしなので「会話」系の汎用エンジンを選ぶ
#           （医療・金融などの専門エンジンではなく汎用でよい）
# 例（ダミー・実際の文字列は MyPage で確認）:
#   AMIVOICE_ENGINE=-a-general
AMIVOICE_ENGINE=


# ----------------------------------------------------------
# [3] AMIVOICE_WS_ENDPOINT  ← 既定のままでよい
# ----------------------------------------------------------
# WebSocket の接続先。
#   ログなし（推奨・機密会議向け）: wss://acp-api.amivoice.com/v1/nolog/
#   ログあり（料金が安い）        : wss://acp-api.amivoice.com/v1/
# 迷ったら nolog のままにする。
AMIVOICE_WS_ENDPOINT=wss://acp-api.amivoice.com/v1/nolog/


# ==========================================================
# 以下は任意。今は空のままでよい。
# ==========================================================

# [4] AMIVOICE_SERVICE_ID  ← 任意（記録用、WebSocket送信には使わない）
# AmiVoice のサービスID。請求・アカウント識別用。
# WebSocket 認証には APPKEY だけを使うため、ここは空でも動作する。
AMIVOICE_SERVICE_ID=
