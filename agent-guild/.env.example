# ---- AgentGuild runtime ----
AG_HOST=127.0.0.1
AG_PORT=5311
AG_DATA_DIR=.data
AG_DB_PATH=.data/agent-guild.sqlite
AG_LOG_DIR=.data/logs

# Master key used to encrypt provider credentials at rest (AES-256-GCM).
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AG_SECRET_KEY=

# Max concurrent agent processes
AG_MAX_CONCURRENT_RUNS=3
# Per-run wall-clock timeout (ms)
AG_RUN_TIMEOUT_MS=1800000
# Allow the dispatcher to actually spawn CLI processes (0 = dry-run / simulation)
AG_ENABLE_EXECUTION=1
# Comma separated absolute path prefixes agents are allowed to work in.
# Empty = only paths registered as projects.
AG_ALLOWED_ROOTS=
