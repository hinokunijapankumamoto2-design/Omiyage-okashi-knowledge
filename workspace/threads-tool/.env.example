# ── Threads API ──────────────────────────────────────
THREADS_USER_ID=数字ID（Threads APIで取得）
THREADS_ACCESS_TOKEN=THAAで始まるアクセストークン

# ── 楽天ウェブサービス API（新ドメイン openapi.rakuten.co.jp）──
# 取得先: https://webservice.rakuten.co.jp/app/list
#
# applicationId : アプリ詳細 > 「アプリID」欄（UUID形式 or 英数字）
# accessKey     : アプリ詳細 > 「アクセスキー」欄（pk_ で始まる文字列）
# origin        : アプリ登録時に入力した「サイトURL」（例: https://example.com）
#                 ※ Pythonから叩く場合は Originヘッダーと一致させる必要あり
#                 ※ 未設定 or 不明なら空欄にして管理者に確認

RAKUTEN_APP_ID=アプリID（UUID or 英数字）
RAKUTEN_ACCESS_KEY=pk_で始まるアクセスキー
RAKUTEN_ORIGIN=アプリ登録時のサイトURL（例: https://example.com）

# ── Google Gemini API（Imagen 4 画像生成）──────────────
# 取得先: https://aistudio.google.com/apikey
# ※ 2026年現在、無料枠では画像生成は使えません（要 Pay-as-you-go）
GEMINI_API_KEY=AIzaSy...で始まるAPIキー

# ── OpenAI API（gpt-image-1 画像生成）──────────────────
# 取得先: https://platform.openai.com/api-keys
# - 必ず Restricted Key を作成（Models: gpt-image-1 / Write）
# - 必ず Usage Limits を設定（Soft $3 / Hard $5 推奨）
# - Pay-as-you-go・最低$5チャージから利用可能
OPENAI_API_KEY=sk-proj-...で始まるAPIキー
