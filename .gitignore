# ========================================
# Omiyage-okashi-knowledge .gitignore
# B2Bコンサル向け：顧客データ誤コミット防止
# ========================================

# ------------------------------------------
# 🔴 最重要：顧客データ・個人ナレッジ
# ------------------------------------------

# Second Brain のユーザーデータ（Vault本体のデータ）
# ※このリポジトリにVaultデータを置かない設計だが、誤配置対策として除外
raw/
wiki/
outputs/

# Wiki の INDEX テンプレートは除外対象から戻す（配布用）
!templates/INDEX.md.template

# Reflection Notes の本体（顧客ノウハウが含まれうる）
mistakes.md
**/mistakes.md

# ユーザー別設定
knowledge-config.json
.claude/knowledge-config.json
.claude/settings.local.json

# ------------------------------------------
# 🔴 最重要：認証情報・シークレット
# ------------------------------------------

# 環境変数ファイル
.env
.env.*
!.env.example

# 認証情報
**/credentials.json
**/.credentials
**/.credentials.json
*.key
*.pem
*.p12
*.pfx
*secret*
*SECRET*

# APIキー・トークン
**/api_keys.json
**/tokens.json
.anthropic-key
.openai-key

# ------------------------------------------
# 🟡 Claude Code 関連（ユーザー固有）
# ------------------------------------------

# プロジェクト固有のClaude Code設定（ユーザー環境依存）
.claude/settings.local.json
.claude/cache/
.claude/history*
.claude/projects/
.claude/sessions/
.claude/todos/
.claude/shell-snapshots/
.claude/backups/
.claude/paste-cache/
.claude/file-history/

# ------------------------------------------
# 🟡 Obsidian 固有（ユーザー環境依存）
# ------------------------------------------

# Obsidian のワークスペース状態
.obsidian/workspace*
.obsidian/cache
.obsidian/app.json
.obsidian/graph.json
.obsidian/core-plugins.json
.obsidian/community-plugins.json
.obsidian/plugins/*/data.json

# ------------------------------------------
# 🟢 OS 由来のゴミファイル
# ------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ------------------------------------------
# 🟢 エディタ・IDE 設定
# ------------------------------------------

# VS Code
.vscode/
!.vscode/settings.example.json

# JetBrains
.idea/
*.iml
*.iws

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# 🟢 ビルド成果物・依存関係
# ------------------------------------------

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# ------------------------------------------
# 🟢 一時ファイル・ログ
# ------------------------------------------

# ログ
*.log
logs/

# 一時ファイル
tmp/
temp/
*.tmp
*.bak
*.backup

# ------------------------------------------
# 🟢 アーカイブ・大容量ファイル
# ------------------------------------------

# バイナリ・圧縮ファイル（配布物以外）
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Obsidianインストーラ等の実行ファイル（誤投入対策）
*.exe
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage

# 大容量メディア（必要に応じて除外解除）
*.mp4
*.mov
*.avi

# ------------------------------------------
# 📝 メモ：除外解除したい場合
# ------------------------------------------
# 特定ファイルだけ配布したい場合は !filename で解除可能
# 例: !examples/sample.pdf
