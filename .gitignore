# ========================================
# Omiyage Meeting Intelligence .gitignore
# ========================================

# ------------------------------------------
# 認証情報・シークレット
# ------------------------------------------
.env
.env.*
!.env.example

**/credentials.json
**/.credentials
**/.credentials.json
*.key
*.pem
*.p12
*.pfx
*secret*
*SECRET*

**/api_keys.json
**/tokens.json
.anthropic-key
.openai-key

# 運用個別の transcribe 設定（example はコミット）
harness/transcribe/config.json

# ------------------------------------------
# Claude Code（ユーザー環境依存）
# ------------------------------------------
.claude/settings.local.json
.claude/cache/
.claude/history*
.claude/projects/
.claude/sessions/
.claude/todos/
.claude/shell-snapshots/
.claude/backups/
.claude/paste-cache/
.claude/file-history/

# ------------------------------------------
# 録音・大容量メディア（リポに置かない）
# ------------------------------------------
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.mp4
*.mov
*.avi
data/**/audio/

# ------------------------------------------
# OS 由来のゴミファイル
# ------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*~
.directory
.Trash-*

# ------------------------------------------
# エディタ・IDE
# ------------------------------------------
.vscode/
.idea/
*.iml
*.iws
*.swp
*.swo
\#*\#
.\#*
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# ビルド成果物・依存関係
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# ------------------------------------------
# ログ・一時ファイル
# ------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.backup

# ------------------------------------------
# アーカイブ・実行ファイル
# ------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.exe
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
